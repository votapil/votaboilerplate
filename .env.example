APP_NAME=Boilerplate
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# API host. The console builds URLs from this.
APP_URL=http://localhost:8080

# Public origin of the SPA. Anything a human clicks (password-reset links,
# verification mails) is built from this, and config/cors.php allows it.
FRONTEND_URL=http://localhost:3000

# Optional dedicated host for the Filament panel. Empty = serve it at /admin
# on the main domain.
ADMIN_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Runtime ───────────────────────────────────────────────────────────────
# The images ship FrankenPHP; Octane's own default is roadrunner.
OCTANE_SERVER=frankenphp
# Set to the public domain in production to let Caddy issue Let's Encrypt certs.
CADDY_SERVER_NAME=

# ── Database (postgres service in docker-compose.yml) ─────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# ── Redis (cache, queue, session, Horizon) ────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Error reporting ───────────────────────────────────────────────────────
# Backs the 'telegram' log channel. Leave both empty and the channel is a no-op.
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=
TELEGRAM_ERROR_LOG_LEVEL=error

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
