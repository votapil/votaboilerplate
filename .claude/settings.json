{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make rebuild)",
      "Bash(make logs:*)",
      "Bash(make artisan:*)",
      "Bash(make composer:*)",
      "Bash(make migrate)",
      "Bash(make test:*)",
      "Bash(make test-front:*)",
      "Bash(make lint:*)",
      "Bash(make schema-map)",
      "Bash(make ts-sync)",
      "Bash(make fix-perms)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec app php artisan:*)",
      "Bash(php -l:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(./archive/**)",
      "Read(archive/**)",
      "Grep(./archive/**)",
      "Glob(./archive/**)"
    ]
  },
  "enableAllProjectMcpServers": true
}
