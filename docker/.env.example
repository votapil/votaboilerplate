# Compose/build settings. Copy to docker/.env before the first `make up`:
#
#     make init      # copies this file and .env.example
#
# docker/.env itself is gitignored (it holds the local credentials), which is
# exactly why this .example must stay in git: without it a fresh clone cannot
# run a single make target.

COMPOSE_PROJECT_NAME=votaboilerplate
COMPOSE_FILE=docker-compose.yml
FRANKENPHP_VERSION=1.4-php8.4

# Postgres (local dev).
# KEEP IN SYNC WITH phpunit.xml: the test run forces DB_USERNAME/DB_PASSWORD and
# DB_DATABASE=<POSTGRES_DB>_testing, so renaming the user or the password here
# breaks `make test` until phpunit.xml is changed too.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=secret

# Redis (local dev). Also used by the healthcheck.
REDIS_PASSWORD=secret
