root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

# The frontend half of the repo (Nuxt/Vue/TS) is 2-space by convention.
[*.{js,ts,mjs,cjs,vue,json}]
indent_size = 2

# Make recipes are tab-only — spaces here produce "missing separator" errors.
[Makefile]
indent_style = tab
